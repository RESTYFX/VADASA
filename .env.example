# Required for Genkit AI Tick Anomaly Advisor (set in Vercel Project Settings -> Environment Variables)
GOOGLE_GENAI_API_KEY=

# Optional: Override Deriv App ID (defaults to built-in app ID if omitted)
DERIV_APP_ID=

# Optional: Override OAuth callback URL (defaults to <origin>/callback automatically)
NEXT_PUBLIC_DERIV_REDIRECT_URI=